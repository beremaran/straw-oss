# Endpoint Worker (.endpoint.env.example)

# ── Required ──────────────────────────────────────────────────────────────────
ENDPOINT_ID=
NATS_URL=nats://localhost:4222
HMAC_SECRET=change-me-in-production

# ── Endpoint ──────────────────────────────────────────────────────────────────
ENDPOINT_TAGS=
CONCURRENCY_LIMIT=25
SELF_UPDATE_URL=
SELF_UPDATE_INTERVAL=5m
SELF_UPDATE_ENABLED=true
MAX_POOL_HOSTS=1000
IDLE_CONNS_PER_HOST=10
IDLE_CONN_TIMEOUT=90s

# ── NATS ──────────────────────────────────────────────────────────────────────
NATS_TOKEN=

# ── Security ──────────────────────────────────────────────────────────────────
TLS_CERT_FILE=
TLS_KEY_FILE=
VAULT_ADDR=

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
METRICS_ENABLED=true
METRICS_PORT=9090
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SDK_DISABLED=false
