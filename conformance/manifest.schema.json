{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beremaran/straw-oss/conformance/manifest.schema.json",
  "title": "Straw conformance fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "compatibility", "fixtures"],
  "properties": {
    "schema_version": {"const": 1},
    "protocol_version": {"type": "string", "pattern": "^v[0-9]+$"},
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "consumers"],
      "properties": {
        "producer": {"type": "string", "minLength": 1},
        "consumers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "outcome"],
        "properties": {
          "path": {"type": "string", "pattern": "^fixtures/v[0-9]+/.+\\.json$"},
          "outcome": {"enum": ["accept", "reject"]}
        }
      }
    }
  }
}
