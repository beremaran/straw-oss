# Build stage
FROM golang:1.25-alpine AS builder

# Install git and make for build dependencies
RUN apk add --no-cache git make

WORKDIR /app

# Cache dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source
COPY . .

# Build arguments
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_TIME=unknown

# Build the binary
# -w -s: strip debug information
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags "-w -s -X main.Version=${VERSION} -X main.GitCommit=${COMMIT} -X main.BuildTime=${BUILD_TIME}" \
    -o /app/endpoint ./cmd/endpoint

# Runtime stage
FROM alpine:latest

WORKDIR /app

# Install ca-certificates for TLS and curl for healthcheck
RUN apk add --no-cache ca-certificates curl

# Create non-root user
RUN adduser -D -g '' appuser

# Copy binary from builder
COPY --from=builder /app/endpoint /app/endpoint

# Set permission for the binary
RUN chown appuser:appuser /app/endpoint && chmod +x /app/endpoint

# Run as non-root user
USER appuser

# Health check (assuming health endpoint is on port 8080 at /healthz)
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:9090/healthz || exit 1

# Entrypoint
ENTRYPOINT ["/app/endpoint"]
