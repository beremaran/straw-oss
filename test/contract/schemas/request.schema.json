{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Protocol Request",
    "type": "object",
    "properties": {
        "id": {
            "type": "string"
        },
        "method": {
            "type": "string"
        },
        "url": {
            "type": "string"
        },
        "headers": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "key": {
                        "type": "string"
                    },
                    "value": {
                        "type": "string"
                    }
                },
                "required": [
                    "key",
                    "value"
                ]
            }
        },
        "body": {
            "type": "string",
            "contentEncoding": "base64"
        },
        "timeout": {
            "type": "integer"
        },
        "fingerprint": {
            "type": "string"
        },
        "session_id": {
            "type": "string"
        },
        "trace_id": {
            "type": "string"
        }
    },
    "required": [
        "id",
        "method",
        "url",
        "headers"
    ]
}