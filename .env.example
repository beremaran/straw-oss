# Straw Proxy Server - Environment Configuration
# Copy this file to .env and update values for your environment

# ==============================================================================
# CORE CONFIGURATION
# ==============================================================================

# PostgreSQL connection string (required for server)
POSTGRES_DSN=postgres://user:password@localhost:5432/straw?sslmode=disable

# Redis address (default: localhost:6379)
REDIS_ADDR=localhost:6379

# RabbitMQ connection URL (required)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Logging level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Log format: json, text (default: json)
LOG_FORMAT=json

# ==============================================================================
# SECURITY CONFIGURATION
# ==============================================================================

# HMAC secret for task signing (required)
HMAC_SECRET=your-secret-key-here-change-in-production

# TLS certificate and key paths (optional, for HTTPS)
# TLS_CERT_FILE=/path/to/cert.pem
# TLS_KEY_FILE=/path/to/key.pem

# HashiCorp Vault address (optional)
# VAULT_ADDR=http://localhost:8200

# ==============================================================================
# OBSERVABILITY CONFIGURATION
# ==============================================================================

# OpenTelemetry collector endpoint (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Enable Prometheus metrics (default: true)
METRICS_ENABLED=true

# Prometheus metrics port (default: 9090)
METRICS_PORT=9090

# ==============================================================================
# SERVER-SPECIFIC CONFIGURATION (Relay Server / The Brain)
# ==============================================================================

# HTTP server port (default: 8080)
HTTP_PORT=8080

# Admin API port (default: 8081)
ADMIN_PORT=8081

# Graceful shutdown timeout (default: 30s)
# SHUTDOWN_TIMEOUT=30s

# Admin API authentication key
# ADMIN_API_KEY=your-admin-key-here

# ==============================================================================
# ENDPOINT-SPECIFIC CONFIGURATION (Endpoint Worker / The Muscle)
# ==============================================================================

# Unique identifier for this endpoint (required for endpoint)
# ENDPOINT_ID=endpoint-us-res-001

# Comma-separated capability tags
# ENDPOINT_TAGS=type:residential,region:us,capability:stealth

# Maximum concurrent requests (default: 100)
CONCURRENCY_LIMIT=100

# Binary self-update URL (optional)
# SELF_UPDATE_URL=https://updates.example.com/endpoint
