# ── Dev Environment Defaults ─────────────────────────────────────────────────
# Copy this file to .dev.env and adjust values as needed.
# This file is used by docker-compose.dev.yml for the dev service.

# ── Relay Server ─────────────────────────────────────────────────────────────
POSTGRES_DSN=postgres://straw:straw@postgres:5432/straw?sslmode=disable
NATS_URL=nats://nats:4222
REDIS_ADDR=redis:6379
HMAC_SECRET=dev-secret-change-me
DB_AUTO_MIGRATE=true
ALLOW_PRIVATE_IPS=true

# ── Endpoint Worker ──────────────────────────────────────────────────────────
ENDPOINT_ID=dev-worker-01
ENDPOINT_TAGS=type:dev,region:local
CONCURRENCY_LIMIT=25

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=text
METRICS_ENABLED=true
