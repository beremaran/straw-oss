# Copy to .env and replace every value. Do not commit .env.
STRAW_AUTH_TOKEN=replace-with-a-long-random-token
# Required only with compose.runtime-admin.yml; use a different value.
STRAW_ADMIN_TOKEN=replace-with-a-different-long-random-token
NATS_USER=straw
NATS_PASSWORD=replace-with-a-long-random-password
# Required only by compose.ha.yml; use a distinct secret.
REDIS_PASSWORD=replace-with-a-long-random-redis-password
# Required only by compose.object-storage.yml.
STRAW_RECEIPT_SIGNING_KEY=replace-with-at-least-32-random-bytes
STRAW_S3_ACCESS_KEY=replace-with-s3-access-key
STRAW_S3_SECRET_KEY=replace-with-s3-secret-key
STRAW_S3_SESSION_TOKEN=
STRAW_CONTROL_API_PORT=8080
STRAW_CONTROL_METRICS_PORT=9090
