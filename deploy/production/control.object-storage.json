{
  "config_version": "v1",
  "control": {
    "nats": {
      "servers": ["nats://nats:4222"],
      "username_env": "STRAW_NATS_USER",
      "password_env": "STRAW_NATS_PASSWORD",
      "max_payload_bytes": 2000000
    },
    "object_storage": {
      "enabled": true,
      "backend": "s3",
      "endpoint": "https://s3.example.invalid",
      "bucket": "straw-receipts",
      "region": "us-east-1",
      "access_key_env": "STRAW_S3_ACCESS_KEY",
      "secret_key_env": "STRAW_S3_SECRET_KEY",
      "session_token_env": "STRAW_S3_SESSION_TOKEN",
      "signing_key_env": "STRAW_RECEIPT_SIGNING_KEY",
      "download_base_url": "http://control:8080",
      "max_object_bytes": 1073741824,
      "max_part_bytes": 16777216,
      "retention_seconds": 86400,
      "assignment_ttl_seconds": 300,
      "server_side_encryption": "AES256"
    }
  }
}
