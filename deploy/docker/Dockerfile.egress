# Build the Straw egress worker.
FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/egress ./cmd/egress

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/egress /egress
ENTRYPOINT ["/egress", "-config", "/etc/straw/egress.json"]
