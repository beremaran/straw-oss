{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Request Rate by Status",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(relay_requests_total[1m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "title": "Latency P99",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(relay_request_duration_seconds_bucket[1m])) by (le, rule_id))",
          "legendFormat": "p99 {{rule_id}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(relay_request_duration_seconds_bucket[1m])) by (le, rule_id))",
          "legendFormat": "p95 {{rule_id}}"
        }
      ]
    },
    {
      "title": "Active Sessions",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "relay_active_sessions",
          "legendFormat": "Active Sessions"
        }
      ]
    },
    {
      "title": "Queue Depth",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "relay_queue_depth",
          "legendFormat": "{{queue_name}}"
        }
      ]
    },
    {
      "title": "Cache Hit Ratio",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(relay_cache_hits_total[1m])) / (sum(rate(relay_cache_hits_total[1m])) + sum(rate(relay_cache_misses_total[1m])))",
          "legendFormat": "Hit Ratio"
        }
      ]
    },
    {
      "title": "Rate Limit Exceeded",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "targets": [
        {
          "expr": "rate(relay_rate_limit_exceeded_total[1m])",
          "legendFormat": "{{quota_key}}"
        }
      ]
    }
  ],
  "schemaVersion": 30,
  "style": "dark",
  "tags": ["server", "straw-proxy"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
