{
    "annotations": {
        "list": [
            {
                "builtIn": 1,
                "datasource": "-- Grafana --",
                "enable": true,
                "hide": true,
                "iconColor": "rgba(0, 211, 255, 1)",
                "name": "Annotations & Alerts",
                "type": "dashboard"
            }
        ]
    },
    "editable": true,
    "gnetId": null,
    "graphTooltip": 0,
    "id": null,
    "links": [],
    "panels": [
        {
            "title": "Upstream Requests per Domain",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "expr": "sum(rate(endpoint_upstream_duration_seconds_count[1m])) by (target_domain)",
                    "legendFormat": "{{target_domain}}"
                }
            ]
        },
        {
            "title": "Upstream Latency P99",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.99, sum(rate(endpoint_upstream_duration_seconds_bucket[1m])) by (le, target_domain))",
                    "legendFormat": "p99 {{target_domain}}"
                }
            ]
        },
        {
            "title": "Tasks In Flight",
            "type": "stat",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 8,
                "w": 6,
                "x": 0,
                "y": 8
            },
            "targets": [
                {
                    "expr": "endpoint_tasks_in_flight",
                    "legendFormat": "Tasks In Flight"
                }
            ]
        },
        {
            "title": "Fingerprint Distribution",
            "type": "piechart",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 8,
                "w": 6,
                "x": 6,
                "y": 8
            },
            "targets": [
                {
                    "expr": "sum(endpoint_tls_fingerprint_used) by (fingerprint)",
                    "legendFormat": "{{fingerprint}}"
                }
            ]
        },
        {
            "title": "Pooled Connections",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 8
            },
            "targets": [
                {
                    "expr": "endpoint_connections_pooled",
                    "legendFormat": "{{target_host}}"
                }
            ]
        }
    ],
    "schemaVersion": 30,
    "style": "dark",
    "tags": [
