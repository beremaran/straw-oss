    "panels": [
        {
            "title": "Goroutines",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "expr": "go_goroutines",
                    "legendFormat": "Goroutines {{job}}"
                }
            ]
        },
        {
            "title": "Memory Usage (Heap Alloc)",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "targets": [
                {
                    "expr": "go_memstats_alloc_bytes",
                    "legendFormat": "Alloc {{job}}"
                },
                {
                    "expr": "go_memstats_sys_bytes",
                    "legendFormat": "Sys {{job}}"
                }
            ]
        },
        {
            "title": "CPU Usage",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 8
            },
            "targets": [
                {
                    "expr": "rate(process_cpu_seconds_total[1m])",
                    "legendFormat": "CPU {{job}}"
                }
            ]
        },
        {
            "title": "GC Duration",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 8
            },
            "targets": [
                {
                    "expr": "rate(go_gc_duration_seconds_sum[1m]) / rate(go_gc_duration_seconds_count[1m])",
                    "legendFormat": "Avg GC Duration {{job}}"
                }
            ]
        }
    ],
