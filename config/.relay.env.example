# Relay Server (.relay.env.example)

# ── Required ──────────────────────────────────────────────────────────────────
POSTGRES_DSN=
NATS_URL=nats://localhost:4222
HMAC_SECRET=change-me-in-production

# ── Database ──────────────────────────────────────────────────────────────────
DB_AUTO_MIGRATE=false

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_POOL_SIZE=100
REDIS_MIN_IDLE_CONNS=10

# ── NATS ──────────────────────────────────────────────────────────────────────
NATS_TOKEN=

# ── Server ────────────────────────────────────────────────────────────────────
HTTP_PORT=8080
ADMIN_PORT=8081
SHUTDOWN_TIMEOUT=30s
ADMIN_API_KEY=
RESULT_TIMEOUT=30s
MAX_BODY_SIZE=2M
MAX_CONCURRENT_REQUESTS=50
ALLOW_PRIVATE_IPS=false

# ── Security ──────────────────────────────────────────────────────────────────
TLS_CERT_FILE=
TLS_KEY_FILE=
VAULT_ADDR=

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
METRICS_ENABLED=true
METRICS_PORT=9090
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SDK_DISABLED=false
